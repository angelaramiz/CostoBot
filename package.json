{
  "name": "costobot",
  "version": "0.1.0",
  "private": true,
  "description": "CostoBot SaaS — Calculadora de costos con IA conversacional",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"next dev\" \"node backend/server.js\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "version:patch": "node frontend/pre-bump-validation.js && node frontend/bump-version.js patch",
    "version:minor": "node frontend/pre-bump-validation.js && node frontend/bump-version.js minor",
    "version:major": "node frontend/pre-bump-validation.js && node frontend/bump-version.js major",
    "version:rollback": "node frontend/rollback-version.js",
    "version:setup-hooks": "node frontend/setup-hooks.js",
    "version:remove-hooks": "node frontend/setup-hooks.js --remove",
    "version:audit": "node frontend/pre-bump-validation.js",
    "version:check": "node -e \"const {checkVersion}=require('./frontend/version-checker');checkVersion()\"",
    "context:audit": "node .claude/scripts/context-audit.js",
    "context:update": "node .claude/scripts/context-update.js",
    "context:adr": "node .claude/scripts/context-adr.js",
    "rules:add": "node .claude/scripts/rules-add.js",
    "rules:list": "node .claude/scripts/rules-list.js",
    "memory:export": "node .claude/scripts/memory-export.js",
    "memory:import": "node .claude/scripts/memory-import.js"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@xyflow/react": "^12.10.1",
    "dotenv": "^16.0.0",
    "firebase": "^11.10.0",
    "next": "^16.2.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "zod": "^3.22.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.1",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^30.3.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
