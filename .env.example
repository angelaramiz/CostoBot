# .env.example — CostoBot
# Template for .env — commit this file, NOT .env.
# Copy to .env and fill in your values.

# ============================================================
# VERSIONING — GitHub AUTONOMOUS push
# ============================================================
GIT_PAT_TOKEN=
GIT_REPO_URL=https://github.com/YOUR_USER/CostoBot.git
GIT_BRANCH=main
# Set to "s" to skip interactive confirmation (required in non-TTY environments)
COSTOBOT_AUTO_VERSION=s

# ============================================================
# API KEYS — Generate unique keys for your deployment
# ============================================================
PUBLIC_API_KEY=
INTERNAL_API_KEY=

# ============================================================
# NEXT.JS PUBLIC VARS — safe to expose in browser bundle
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:3001
# URL del backend para el hook de versionamiento (producción)
VERSION_RECORD_URL=https://your-backend.onrender.com
NEXT_PUBLIC_PUBLIC_API_KEY=
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_APP_NAME=CostoBot

# ============================================================
# DATABASE — MongoDB Atlas
# ============================================================
DATABASE_URL=

# ============================================================
# FIREBASE AUTH
# ============================================================
FIREBASE_APIKEY=
FIREBASE_AUTHDOMAIN=
FIREBASE_PROJECTID=
FIREBASE_STORAGEBUCKET=
FIREBASE_MESSAGINGSENDERID=
FIREBASE_APPID=
FIREBASE_MEASUREMENTID=

# Firebase Admin (backend only)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ============================================================
# IA PROVIDERS
# ============================================================
IA_PROVIDER=openrouter
OPENROUTER_API_KEY=
LMSTUDIO_BASE_URL=http://localhost:1234
OLLAMA_BASE_URL=http://localhost:11434
IA_DEFAULT_MODEL=meta-llama/llama-3.1-8b-instruct

# ============================================================
# BACKEND SERVER
# ============================================================
PORT=3001
NODE_ENV=development
CORS_ALLOWED_ORIGIN=http://localhost:3000
